{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@biotap/proto": ["../../packages/biotap-proto/src/index.ts"],
      "@biotap/native": ["../../packages/biotap-native/src/index.ts"]
    }
  },
  "include": ["src/**/*", "App.tsx", "index.js", "metro.config.js"]
}
