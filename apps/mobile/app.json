{
  "expo": {
    "name": "BioTap",
    "slug": "biotap-core",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.biotap.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
